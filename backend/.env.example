# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# ── OpenRouter (LLM provider) ───────────────────────────────
# Get an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Model to use — Claude 3.5 Sonnet recommended (handles 6-tool loop reliably)
# Other options: anthropic/claude-3-haiku, openai/gpt-4o, meta-llama/llama-3.1-70b
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
LLM_PROVIDER=openrouter

# ── Supabase ────────────────────────────────────────────────
# Self-hosted: http://<server-ip>:8000
SUPABASE_URL=http://10.9.0.115:8000

# Service-role key — Settings → API → "service_role".
# NEVER expose this in the frontend. Backend only.
SUPABASE_SERVICE_ROLE_KEY=eyJ...REPLACE_ME

# ── CORS ────────────────────────────────────────────────────
# Comma-separated allowed frontend origins. Defaults to localhost:5173 only.
# Add your machine's LAN IP when accessing from another device:
# ALLOWED_ORIGINS=http://localhost:5173,http://10.9.0.109:5173
# Allow all (dev/demo only):
# ALLOWED_ORIGINS=*

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
