# Copy this file to .env and fill in your Supabase credentials.
# The import scripts load this automatically if python-dotenv is installed:
#   pip install python-dotenv
#
# Both scripts (import_faculty.py, import_publications.py) require:
#   SUPABASE_URL             — your project REST endpoint
#   SUPABASE_SERVICE_ROLE_KEY — bypasses RLS; required for INSERT/UPDATE
#
# The anon key is READ-ONLY (RLS blocks writes) — use service_role here.
# Find both in: Supabase dashboard → Settings → API
#
# VITE_SUPABASE_URL is accepted as a fallback for SUPABASE_URL (same value).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
