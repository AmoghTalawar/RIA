# ============================================================
# RIA Dashboard — Frontend Environment Variables EXAMPLE
# Copy this file to .env and fill in your values
# ============================================================

# ── Supabase (Frontend / React — VITE_ prefix required) ─────
VITE_SUPABASE_URL=http://<your-supabase-host>:54321
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Backend API URLs ─────────────────────────────────────────
VITE_RIA_BACKEND_URL=http://<your-server-ip>:5002
VITE_CHAT_API_URL=http://<your-server-ip>:5002

# ============================================================
# Backend-only vars (read by Python FastAPI from backend/.env)
# ============================================================
SUPABASE_URL=http://<your-supabase-host>:54321
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-anon-key>
PORT=5002
GROQ_API_KEY=<your-groq-api-key>
